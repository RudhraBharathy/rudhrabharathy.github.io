{
  "name": "rudhra-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && yarn likes:check",
    "build": "yarn run check && astro build",
    "preview": "astro preview",
    "likes:dev": "wrangler dev --config workers/likes/wrangler.jsonc",
    "likes:check": "wrangler types workers/likes/worker-configuration.d.ts --config workers/likes/wrangler.jsonc && tsc --project workers/likes/tsconfig.json",
    "likes:deploy": "wrangler deploy --config workers/likes/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "posthog-js": "^1.453.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@posthog/rollup-plugin": "^1.6.4",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  }
}
