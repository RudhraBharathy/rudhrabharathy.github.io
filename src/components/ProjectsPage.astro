---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Projects from "./Projects.astro";
import {
  articleClass,
  inlineLinkClass,
  labelClass,
  titleClass,
} from "../styles/classes";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<main id="main">
  <article class={articleClass}>
    <a class={inlineLinkClass} href="/">
      <Icon name="lucide:arrow-left" size={16} aria-hidden="true" />Back home
    </a>
    <span class:list={[labelClass, "mt-8 mb-0.75 block text-accent"]}>
      Selected work
    </span>
    <h1 class:list={[titleClass, "mt-2 mb-4.5"]}>Projects</h1>
    <p class="max-w-[64ch] text-muted">
      Browser extensions, web applications, and small experiments built to
      make an idea useful.
    </p>
    <div class="mt-6">
      <Projects projects={projects} />
    </div>
  </article>
</main>
