---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import portraitImage from "../assets/portrait.jpg";
import { person } from "../data";
import {
  iconButtonClass,
  inlineLinkClass,
  labelClass,
  titleClass,
} from "../styles/classes";

const socialIconClass = `${iconButtonClass} min-h-8 min-w-8 p-1.5`;
const factIconClass =
  "flex h-7 w-7 shrink-0 items-center justify-center rounded-[5px] border border-line bg-wash text-muted";
---

<div>
  <div
    class="draft-grid relative h-38.5 overflow-hidden border-b border-line bg-page max-wide:h-28 [&_svg]:size-full [&_svg]:text-drawing"
    aria-hidden="true"
  >
    <svg viewBox="0 0 760 154" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="currentColor" opacity=".45">
        <path
          d="M-20 142L243 -10M340 178L720 -40M110 28H646M110 133H646"
          stroke-dasharray="4 5"></path>
        <path d="M176 10V143M580 10V143"></path>
      </g>
      <g transform="translate(223 104) skewY(-8)">
        <text
          class="fill-surface stroke-current font-display text-[122px] font-bold tracking-[-9px] stroke-[1.3px]"
          x="4"
          y="8">-RB-</text
        >
        <text
          class="fill-surface stroke-current font-display text-[122px] font-bold tracking-[-9px] stroke-[1.3px]"
          >-RB-</text
        >
      </g>
    </svg>
  </div>
  <div
    class="flex items-center gap-5 border-b border-line px-7 py-6.25 max-wide:gap-3.25 max-wide:px-4.25 [&>div]:min-w-0"
  >
    <Image
      class="h-35 w-35 shrink-0 rounded-sm border border-line object-cover max-wide:h-19.5 max-wide:w-17.5"
      src={portraitImage}
      alt="Rudhra Bharathy"
      width={160}
      height={160}
      loading="eager"
      fetchpriority="high"
    />
    <div>
      <h1 class={titleClass}>{person.name}</h1>
      <p class="mt-1.5 text-muted">
        Developer & Technical Solutions Engineer
      </p>
    </div>
  </div>
  <div
    class="profile-facts grid grid-cols-2 border-b border-line max-wide:grid-cols-1"
  >
    <div class="space-y-2.5 px-7 py-4 max-wide:px-4.25">
      <div class="flex items-center gap-3">
        <span class={factIconClass} aria-hidden="true">
          <Icon name="lucide:map-pin" size={15} />
        </span>
        <a
          href={person.locationLink}
          target="_blank"
          rel="noopener noreferrer">Coimbatore, Tamil Nadu, India</a
        >
      </div>
      <div class="flex items-center gap-3">
        <span class={factIconClass} aria-hidden="true">
          <Icon name="lucide:mail" size={15} />
        </span>
        <div class="copy-inline-group inline-flex items-center gap-4">
          <a href={`mailto:${person.email}`}>{person.email}</a>
          <button
            class:list={[
              iconButtonClass,
              "copy-inline-button h-7 w-7 shrink-0 border border-line text-muted",
            ]}
            type="button"
            data-copy-profile={person.email}
            data-copy-label="Email address"
            aria-label="Copy email address"
          >
            <span data-copy-default aria-hidden="true">
              <Icon name="lucide:copy" size={13} />
            </span>
            <span class="hidden text-accent" data-copy-success aria-hidden="true">
              <Icon name="lucide:check" size={13} />
            </span>
          </button>
        </div>
      </div>
    </div>
    <div
      class="space-y-2.5 border-l border-line px-7 py-4 max-wide:border-t max-wide:border-l-0 max-wide:px-4.25"
    >
      <div class="flex items-center gap-3">
        <span class={factIconClass} aria-hidden="true">
          <Icon name="lucide:clock" size={15} />
        </span>
        <p>
          <time data-local-time>--:--</time>
          <span class="text-muted">· UTC+5:30</span>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <span class={factIconClass} aria-hidden="true">
          <Icon name="lucide:phone" size={15} />
        </span>
        <div class="copy-inline-group inline-flex items-center gap-4">
          <a href="tel:+918870562981">+91 88705 62981</a>
          <button
            class:list={[
              iconButtonClass,
              "copy-inline-button h-7 w-7 shrink-0 border border-line text-muted",
            ]}
            type="button"
            data-copy-profile="+91 88705 62981"
            data-copy-label="Phone number"
            aria-label="Copy phone number"
          >
            <span data-copy-default aria-hidden="true">
              <Icon name="lucide:copy" size={13} />
            </span>
            <span class="hidden text-accent" data-copy-success aria-hidden="true">
              <Icon name="lucide:check" size={13} />
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <span class="sr-only" data-profile-copy-status role="status"></span>
  <div
    class="grid grid-cols-2 border-b border-line leading-[1.55] [&>div]:px-7 [&>div]:py-3.5 [&>div+div]:border-l [&>div+div]:border-line max-wide:[&>div]:px-4 max-wide:[&>div]:py-3 max-wide:[&>div]:text-sm"
  >
    <div>
      <small class:list={[labelClass, "mb-1 block text-muted"]}>Currently</small>
      Technical Solutions Engineer at <a
        class={inlineLinkClass}
        href="https://www.userflow.com/">Userflow</a
      >
    </div>
    <div>
      <small class:list={[labelClass, "mb-1 block text-muted"]}>Socials</small>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <a
          class={socialIconClass}
          href={person.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit LinkedIn profile"
          ><Icon name="simple-icons:linkedin" size={19} aria-hidden="true" /></a
        >
        <a
          class={socialIconClass}
          href={person.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit X profile"
          ><Icon name="simple-icons:x" size={19} aria-hidden="true" /></a
        >
        <a
          class={socialIconClass}
          href={person.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit GitHub profile"
          ><Icon name="simple-icons:github" size={19} aria-hidden="true" /></a
        >
        <a
          class={socialIconClass}
          href={person.devdotto}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit DEV profile"
          ><Icon name="fa6-brands:dev" size={19} aria-hidden="true" /></a
        >
      </div>
    </div>
  </div>

  <div
    class="space-y-3 px-7 py-6 max-wide:px-4.25 [&_p]:max-w-[64ch] [&_p]:text-pretty"
  >
    <p>
      I specialize in full-stack web development: building thoughtful interfaces
      and turning product ideas into working solutions.
    </p>
    <p>
      I also work directly with customers, investigate technical issues, and
      help teams turn real-world problems into product improvements.
    </p>
    <p>
      Outside work, I photograph the places I travel and the details I find
      along the way.
    </p>
  </div>
</div>

<script>
  const localTime =
    document.querySelector<HTMLTimeElement>("[data-local-time]");

  function updateLocalTime() {
    if (!localTime) return;

    const now = new Date();
    localTime.dateTime = now.toISOString();
    localTime.textContent = new Intl.DateTimeFormat("en-IN", {
      timeZone: "Asia/Kolkata",
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    })
      .format(now)
      .toUpperCase();
  }

  updateLocalTime();
  window.setInterval(updateLocalTime, 60_000);

  const profileCopyStatus = document.querySelector<HTMLElement>(
    "[data-profile-copy-status]",
  );
  const profileCopyButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-profile]",
  );

  profileCopyButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copyProfile;
      const label = button.dataset.copyLabel || "Value";
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        if (profileCopyStatus) {
          profileCopyStatus.textContent = `${label} copied.`;
        }
        button.querySelector("[data-copy-default]")?.classList.add("hidden");
        button.querySelector("[data-copy-success]")?.classList.remove("hidden");
        window.setTimeout(() => {
          button
            .querySelector("[data-copy-default]")
            ?.classList.remove("hidden");
          button.querySelector("[data-copy-success]")?.classList.add("hidden");
        }, 1500);
      } catch {
        if (profileCopyStatus) {
          profileCopyStatus.textContent = `${label} could not be copied automatically.`;
        }
      }
    });
  });
</script>
