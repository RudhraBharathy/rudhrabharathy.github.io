---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  title?: string;
  description?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div data-masonry-gallery>
  <div
    class="group/grid grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-3 data-ready:relative data-ready:block"
    data-masonry-grid
  >
    {items.map((item, index) => (
      <div
        class="group/item group-data-ready/grid:absolute group-data-ready/grid:top-0 group-data-ready/grid:left-0"
        data-masonry-item
        data-aspect={item.src.height / item.src.width}
      >
        <button
          class="group/card block h-full w-full cursor-zoom-in overflow-hidden rounded-md border border-line bg-wash p-0 text-left text-inherit opacity-100 hover:border-drawing group-data-ready/grid:opacity-0 group-data-ready/grid:transform-[translateY(24px)] group-data-ready/grid:[transition:opacity_450ms_ease,transform_500ms_cubic-bezier(0.2,0.8,0.2,1),border-color_150ms_ease] group-data-visible/item:opacity-100 group-data-visible/item:transform-none motion-reduce:transition-none"
          type="button"
          aria-label={`View ${item.title ?? item.alt}`}
          aria-haspopup="dialog"
          data-masonry-card
          data-index={index}
          data-title={item.title}
          data-description={item.description}
          style={`aspect-ratio: ${item.src.width} / ${item.src.height}`}
        >
          <span class="absolute inset-0 block overflow-hidden rounded-[inherit]">
            <span class="absolute inset-0 block" data-masonry-parallax>
              <Image
                class="pointer-events-none block h-full w-full object-cover select-none [transition:transform_700ms_cubic-bezier(0.2,0.8,0.2,1)] group-hover/card:transform-[scale(1.04)] motion-reduce:transition-none"
                src={item.src}
                alt={item.alt}
                width={1000}
                loading={index < 5 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
              />
            </span>
            {(item.title || item.description) && (
              <span class="pointer-events-none absolute inset-x-0 bottom-0 flex translate-y-0 flex-col gap-0.5 bg-[linear-gradient(transparent,rgb(0_0_0/62%))] px-3.5 pt-10.5 pb-3 text-white opacity-0 transform-[translateY(6px)] [transition:opacity_250ms_ease,transform_350ms_cubic-bezier(0.2,0.8,0.2,1)] group-hover/card:opacity-100 group-hover/card:transform-none group-focus-visible/card:opacity-100 group-focus-visible/card:transform-none [@media(hover:none)]:opacity-100 [@media(hover:none)]:transform-none motion-reduce:transition-none">
                {item.title && (
                  <span class="text-sm leading-[1.3] font-bold">
                    {item.title}
                  </span>
                )}
                {item.description && (
                  <span class="text-xs leading-[1.4] opacity-80">
                    {item.description}
                  </span>
                )}
              </span>
            )}
          </span>
        </button>
      </div>
    ))}
  </div>

  <dialog
    class="m-0 h-screen max-h-none w-screen max-w-none overflow-hidden bg-transparent p-0 text-white [border:0] open:grid open:place-items-center backdrop:bg-[rgb(9_9_11/92%)]"
    aria-label="Photography viewer"
    data-masonry-dialog
  >
    <figure class="m-0 grid max-h-[calc(100vh-4rem)] max-w-[calc(100vw-9rem)] justify-items-center gap-3 [@media(max-width:640px)]:max-w-[calc(100vw-2rem)]">
      <img
        class="block max-h-[calc(100vh-8rem)] max-w-full rounded-md object-contain"
        alt=""
        data-masonry-dialog-image
      />
      <figcaption
        class="flex flex-wrap justify-center gap-x-3.5 gap-y-1 text-center text-[14px] [[hidden]]:hidden"
        data-masonry-dialog-caption
      >
        <span data-masonry-dialog-title></span>
        <span class="opacity-[0.65]" data-masonry-dialog-description></span>
      </figcaption>
    </figure>
    <button
      class="fixed top-4 right-4 grid size-11 cursor-pointer place-items-center rounded-[999px] border border-[rgb(255_255_255/14%)] bg-[rgb(255_255_255/10%)] p-0 text-white [transition:background_150ms_ease] hover:bg-[rgb(255_255_255/18%)]"
      type="button"
      aria-label="Close image"
      data-masonry-dialog-close
    >
      <Icon name="lucide:x" size={20} aria-hidden="true" />
    </button>
    <button
      class="fixed top-[calc(50%-22px)] left-4 grid size-11 cursor-pointer place-items-center rounded-[999px] border border-[rgb(255_255_255/14%)] bg-[rgb(255_255_255/10%)] p-0 text-white [transition:background_150ms_ease] hover:bg-[rgb(255_255_255/18%)] [@media(max-width:640px)]:top-auto [@media(max-width:640px)]:bottom-4"
      type="button"
      aria-label="Previous image"
      data-masonry-dialog-previous
      hidden={items.length < 2}
    >
      <Icon name="lucide:arrow-left" size={20} aria-hidden="true" />
    </button>
    <button
      class="fixed top-[calc(50%-22px)] right-4 grid size-11 cursor-pointer place-items-center rounded-[999px] border border-[rgb(255_255_255/14%)] bg-[rgb(255_255_255/10%)] p-0 text-white [transition:background_150ms_ease] hover:bg-[rgb(255_255_255/18%)] [@media(max-width:640px)]:top-auto [@media(max-width:640px)]:bottom-4"
      type="button"
      aria-label="Next image"
      data-masonry-dialog-next
      hidden={items.length < 2}
    >
      <Icon name="lucide:arrow-right" size={20} aria-hidden="true" />
    </button>
  </dialog>
</div>

<script>
  const GAP = 12;
  const COLUMN_WIDTH = 220;
  const PARALLAX_STRENGTH = 0.18;

  const clamp = (value: number, min: number, max: number) =>
    Math.min(max, Math.max(min, value));

  document
    .querySelectorAll<HTMLElement>("[data-masonry-gallery]")
    .forEach((gallery) => {
      const grid = gallery.querySelector<HTMLElement>("[data-masonry-grid]");
      const items = Array.from(
        gallery.querySelectorAll<HTMLElement>("[data-masonry-item]"),
      );
      const cards = Array.from(
        gallery.querySelectorAll<HTMLButtonElement>("[data-masonry-card]"),
      );
      const dialog = gallery.querySelector<HTMLDialogElement>(
        "[data-masonry-dialog]",
      );
      const dialogImage = gallery.querySelector<HTMLImageElement>(
        "[data-masonry-dialog-image]",
      );
      const dialogCaption = gallery.querySelector<HTMLElement>(
        "[data-masonry-dialog-caption]",
      );
      const dialogTitle = gallery.querySelector<HTMLElement>(
        "[data-masonry-dialog-title]",
      );
      const dialogDescription = gallery.querySelector<HTMLElement>(
        "[data-masonry-dialog-description]",
      );
      const closeButton = gallery.querySelector<HTMLButtonElement>(
        "[data-masonry-dialog-close]",
      );
      const previousButton = gallery.querySelector<HTMLButtonElement>(
        "[data-masonry-dialog-previous]",
      );
      const nextButton = gallery.querySelector<HTMLButtonElement>(
        "[data-masonry-dialog-next]",
      );

      if (
        !grid ||
        !dialog ||
        !dialogImage ||
        !dialogCaption ||
        !dialogTitle ||
        !dialogDescription ||
        !closeButton ||
        !previousButton ||
        !nextButton
      )
        return;

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let activeIndex = 0;
      let lastTrigger: HTMLButtonElement | null = null;
      let parallaxFrame = 0;
      let previousOverflow = "";

      const updateParallax = () => {
        parallaxFrame = 0;
        if (reducedMotion.matches) return;

        const viewportCenter = window.innerHeight / 2;
        items.forEach((item) => {
          const layer = item.querySelector<HTMLElement>(
            "[data-masonry-parallax]",
          );
          if (!layer) return;

          const bounds = item.getBoundingClientRect();
          if (bounds.bottom < -200 || bounds.top > window.innerHeight + 200)
            return;

          const reach = PARALLAX_STRENGTH * 0.2 * bounds.height;
          const shift = clamp(
            -(bounds.top + bounds.height / 2 - viewportCenter) *
              PARALLAX_STRENGTH *
              0.25,
            -reach,
            reach,
          );
          layer.style.transform = `translate3d(0, ${shift.toFixed(2)}px, 0) scale(${(
            1 +
            PARALLAX_STRENGTH * 0.4
          ).toFixed(3)})`;
        });
      };

      const scheduleParallax = () => {
        if (!parallaxFrame)
          parallaxFrame = requestAnimationFrame(updateParallax);
      };

      const layout = () => {
        const width = grid.clientWidth;
        if (!width || !items.length) return;

        const columns = Math.min(
          items.length,
          Math.max(1, Math.floor((width + GAP) / (COLUMN_WIDTH + GAP))),
        );
        const itemWidth = (width - GAP * (columns - 1)) / columns;
        const heights = new Array<number>(columns).fill(0);

        items.forEach((item) => {
          const shortest = Math.min(...heights);
          const column = heights.indexOf(shortest);
          const aspect = Number(item.dataset.aspect) || 1;
          const height = itemWidth * aspect;

          item.style.width = `${itemWidth}px`;
          item.style.height = `${height}px`;
          item.style.left = `${column * (itemWidth + GAP)}px`;
          item.style.top = `${shortest}px`;
          heights[column] = shortest + height + GAP;
        });

        grid.style.height = `${Math.max(...heights) - GAP}px`;
        grid.dataset.ready = "";
        scheduleParallax();
      };

      const showImage = (index: number) => {
        const card = cards[index];
        const image = card?.querySelector<HTMLImageElement>("img");
        if (!card || !image) return;

        activeIndex = index;
        dialogImage.src = image.currentSrc || image.src;
        dialogImage.alt = image.alt;
        dialogTitle.textContent = card.dataset.title ?? "";
        dialogDescription.textContent = card.dataset.description ?? "";
        dialogCaption.hidden = !card.dataset.title && !card.dataset.description;
      };

      const stepImage = (direction: number) => {
        if (cards.length < 2) return;
        showImage((activeIndex + direction + cards.length) % cards.length);
      };

      cards.forEach((card, index) => {
        card.addEventListener("click", () => {
          lastTrigger = card;
          showImage(index);
          previousOverflow = document.documentElement.style.overflow;
          document.documentElement.style.overflow = "hidden";
          dialog.showModal();
          closeButton.focus();
        });
      });

      closeButton.addEventListener("click", () => dialog.close());
      previousButton.addEventListener("click", () => stepImage(-1));
      nextButton.addEventListener("click", () => stepImage(1));
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") stepImage(-1);
        if (event.key === "ArrowRight") stepImage(1);
      });
      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = previousOverflow;
        lastTrigger?.focus();
      });

      if (reducedMotion.matches || !("IntersectionObserver" in window)) {
        items.forEach((item) => (item.dataset.visible = ""));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              (entry.target as HTMLElement).dataset.visible = "";
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -6% 0px" },
        );
        items.forEach((item) => revealObserver.observe(item));
      }

      const resizeObserver = new ResizeObserver(layout);
      resizeObserver.observe(grid);
      window.addEventListener("scroll", scheduleParallax, { passive: true });
      reducedMotion.addEventListener("change", scheduleParallax);
      layout();
    });
</script>
