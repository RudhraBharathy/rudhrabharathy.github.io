---
import { Icon } from "astro-icon/components";
import { gallery, person } from "../data";
import Masonry from "./Masonry.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import {
  articleClass,
  buttonClass,
  labelClass,
  titleClass,
} from "../styles/classes";
---

<main id="main">
  <article class={articleClass}>
    <Breadcrumbs items={[{ label: "Gallery" }]} />
    <span class:list={[labelClass, "mt-8 mb-0.75 block text-accent"]}>
      Beyond the screen
    </span>
    <h1 class:list={[titleClass, "mt-2 mb-4.5"]}>
      Places, light, and details.
    </h1>
    <p class="max-w-[60ch] text-muted">
      A growing photo journal of moments I wanted to remember.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a
        class={buttonClass}
        href={person.photography}
        data-analytics-event="social_link_clicked"
        data-analytics-platform="instagram"
        data-analytics-location="gallery"
        target="_blank"
        rel="noopener noreferrer"
      >
        Follow on Instagram
        <Icon name="lucide:arrow-up-right" size={15} aria-hidden="true" />
      </a>
    </div>
    <div class="mt-8">
      <Masonry items={gallery} />
    </div>
  </article>
</main>
