---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import kodaiImage from "../assets/kodai.jpg";
import { person } from "../data";
import {
  articleClass,
  buttonClass,
  inlineLinkClass,
  labelClass,
  titleClass,
} from "../styles/classes";
---

<main id="main">
  <article class={articleClass}>
    <a class={inlineLinkClass} href="/">
      <Icon name="lucide:arrow-left" size={16} aria-hidden="true" />Back home
    </a>
    <span class:list={[labelClass, "mt-8 mb-0.75 block text-accent"]}>
      Beyond the screen
    </span>
    <h1 class:list={[titleClass, "mt-2 mb-4.5"]}>Places, light, and details.</h1>
    <p class="max-w-[60ch] text-muted">
      A growing collection of photographs from the places I visit. More frames
      will land here over time.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a
        class={buttonClass}
        href={person.photography}
        target="_blank"
        rel="noopener noreferrer"
      >
        Follow on Instagram
        <Icon name="lucide:arrow-up-right" size={15} aria-hidden="true" />
      </a>
    </div>
    <figure class="mt-8">
      <Image
        class="block aspect-4/3 w-full rounded-md border border-line object-cover"
        src={kodaiImage}
        alt="Mountain landscape in Kodaikanal"
        width={1000}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="mt-2 flex items-center justify-between gap-4 text-sm">
        <span>Kodai Diaries</span>
        <span class="text-muted">Kodaikanal, Tamil Nadu</span>
      </figcaption>
    </figure>
  </article>
</main>
