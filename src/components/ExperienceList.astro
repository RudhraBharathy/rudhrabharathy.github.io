---
import { experience } from "../data";
import { labelClass } from "../styles/classes";
---

<div class="mt-3">
  {
    experience.map((job, index) => (
      <details class="group border-b border-line py-3" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-center gap-3 max-wide:flex-wrap max-wide:gap-1 [&::-webkit-details-marker]:hidden">
          <span
            class:list={[
              labelClass,
              "w-28.25 shrink-0 text-muted max-wide:w-full",
            ]}
          >
            {job.period}
          </span>
          <span>
            <strong>{job.role}</strong> · {job.company}
          </span>
          <span class="ml-auto text-muted" aria-hidden="true">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">−</span>
          </span>
        </summary>
        <div class="mt-2 mr-7.5 mb-1 ml-31.25 text-sm leading-[1.55] text-muted max-wide:mr-0 max-wide:ml-0">
          <ul class="list-disc space-y-1 pl-4.5">
            {job.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <ul
            class="mt-3 flex list-none flex-wrap gap-1.5 p-0"
            aria-label={`${job.role} technologies`}
          >
            {
              job.technologies.map((technology) => (
                <li
                  class:list={[
                    labelClass,
                    "rounded-sm border border-line px-2 py-0.75 text-ink",
                  ]}
                >
                  {technology}
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    ))
  }
</div>
