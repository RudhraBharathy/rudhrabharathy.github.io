---
import { headingClass } from "../styles/classes";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { projectPath } from "../data";

interface Props {
  projects: CollectionEntry<"projects">[];
  heading?: "h2" | "h3";
}

const { projects, heading: Heading = "h3" } = Astro.props;
---

<div class="mt-4">
  {projects.map(({ id, data }) => (
    <a
      class="group grid grid-cols-[100px_1fr_auto] items-center gap-4.5 border-t border-line py-3.75 no-underline hover:border-drawing hover:bg-wash motion-safe:transition-colors motion-safe:duration-150 max-wide:grid-cols-[72px_1fr_16px] max-wide:gap-2.5 print:block print:break-inside-avoid"
      href={projectPath(id)}
      data-analytics-event="project_clicked"
      data-project={id}
      data-project-name={data.title}
    >
      <Image
        class="aspect-[1.55] w-full rounded-[5px] border border-line object-cover print:hidden"
        src={data.image}
        alt={data.imageAlt}
        width={200}
        loading="lazy"
      />
      <div class="min-w-0">
        <Heading
          class:list={[
            headingClass,
            "text-[21px] leading-[1.2] max-wide:text-[19px] group-hover:transition-colors group-hover:text-accent",
          ]}
        >
          {data.title}
        </Heading>
        <p class="mt-1 text-sm leading-[1.55] text-muted max-wide:text-[13px]">
          {data.summary}
        </p>
      </div>
      <Icon
        name="lucide:arrow-right"
        class="shrink-0 transition-transform duration-300 mr-3 group-hover:-rotate-z-45 group-hover:text-accent"
        size={20}
        aria-hidden="true"
      />
    </a>
  ))}
</div>
