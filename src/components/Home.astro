---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import kodaiImage from "../assets/kodai.jpg";
import { stack } from "../data";
import {
  inlineLinkClass,
  sectionTitleClass,
} from "../styles/classes";
import ContactSection from "./ContactSection.astro";
import ExperienceList from "./ExperienceList.astro";
import HomeProfile from "./HomeProfile.astro";
import Projects from "./Projects.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<main id="main">
  <HomeProfile />
  <div class="min-w-0">
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      id="projects"
      aria-labelledby="projects-heading"
    >
      <h2 class={sectionTitleClass} id="projects-heading">Things I’ve made.</h2>
      <Projects projects={projects} />
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="experience-heading"
    >
      <h2 class={sectionTitleClass} id="experience-heading">Experience</h2>
      <ExperienceList />
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="stack-heading"
    >
      <h2 class={sectionTitleClass} id="stack-heading">Stack</h2>
      <ol class="mt-4 border-t border-line">
        {
          stack.map((group) => (
            <li class="grid grid-cols-[150px_1fr] gap-5 border-b border-line py-4 max-wide:grid-cols-1 max-wide:gap-2.5">
              <div class="flex items-baseline gap-2.5">
                <h3 class="font-semibold">{group.label}</h3>
              </div>
              <ul class="flex list-none flex-wrap gap-2 p-0">
                {group.items.map((item) => (
                  <li class="inline-flex items-center gap-2 rounded-md border border-line bg-wash px-2.5 py-1.5 text-sm">
                    <Icon
                      name={item.icon}
                      class="shrink-0 text-muted"
                      size={15}
                      aria-hidden="true"
                    />
                    {item.label}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="about-heading"
    >
      <h2 class={sectionTitleClass} id="about-heading">Beyond the screen.</h2>
      <div
        class="mt-4 flex items-center gap-4.5 max-wide:items-start [&_p]:max-w-110 [&_a]:text-sm [&_a]:leading-[1.55] leading-[1.55]"
      >
        <Image
          class="h-20.5 w-27.5 rounded-sm object-cover"
          src={kodaiImage}
          alt="Mountain landscape in Kodaikanal"
          width={220}
          loading="lazy"
        />
        <div>
          <p>I take photos when I travel. This one is from my Kodai Diaries.</p>
          <a class={inlineLinkClass} href="/gallery/"
            >Open the gallery <Icon
              name="lucide:arrow-right"
              size={15}
              aria-hidden="true"
            /></a
          >
        </div>
      </div>
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <ContactSection />
  </div>
</main>
