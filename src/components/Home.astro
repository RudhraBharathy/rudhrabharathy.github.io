---
import type { CollectionEntry } from "astro:content";
import { sectionTitleClass } from "../styles/classes";
import ContactSection from "./ContactSection.astro";
import ExperienceList from "./ExperienceList.astro";
import GalleryTeaser from "./GalleryTeaser.astro";
import HomeProfile from "./HomeProfile.astro";
import Projects from "./Projects.astro";
import Stack from "./Stack.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<main id="main">
  <HomeProfile />
  <div class="min-w-0">
    <div
      class="section-divider h-2.25 border-y border-line"
      aria-hidden="true"
    ></div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      id="projects"
      aria-labelledby="projects-heading"
    >
      <h2 class={sectionTitleClass} id="projects-heading">
        Things I’ve made.
      </h2>
      <Projects projects={projects} />
    </section>
    <div
      class="section-divider h-2.25 border-y border-line"
      aria-hidden="true"
    ></div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="experience-heading"
    >
      <h2 class={sectionTitleClass} id="experience-heading">
        Experience
      </h2>
      <ExperienceList />
    </section>
    <div
      class="section-divider h-2.25 border-y border-line"
      aria-hidden="true"
    ></div>
    <Stack />
    <div
      class="section-divider h-2.25 border-y border-line"
      aria-hidden="true"
    ></div>
    <GalleryTeaser />
    <div
      class="section-divider h-2.25 border-y border-line"
      aria-hidden="true"
    ></div>
    <ContactSection />
  </div>
</main>
