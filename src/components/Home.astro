---
import {
  buttonClass,
  iconButtonClass,
  titleClass,
  sectionTitleClass,
  labelClass,
  inlineLinkClass,
} from "../styles/classes";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import portraitImage from "../assets/portrait.jpg";
import kodaiImage from "../assets/kodai.jpg";
import ExperienceList from "./ExperienceList.astro";
import Projects from "./Projects.astro";
import { person, stack } from "../data";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const socialIconClass = `${iconButtonClass} min-h-8 min-w-8 p-1.5 motion-safe:transition-transform`;
const fieldClass =
  "mt-1.5 w-full rounded-md border border-line bg-page px-3 py-2.5 text-ink placeholder:text-muted focus:border-drawing focus:outline-none";
---

<main id="main">
  <div>
    <div
      class="draft-grid relative h-38.5 overflow-hidden border-b border-line bg-page max-wide:h-28 [&_svg]:size-full [&_svg]:text-drawing"
      aria-hidden="true"
    >
      <svg viewBox="0 0 760 154" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke="currentColor" opacity=".45">
          <path
            d="M-20 142L243 -10M340 178L720 -40M110 28H646M110 133H646"
            stroke-dasharray="4 5"></path>
          <path d="M176 10V143M580 10V143"></path>
        </g>
        <g transform="translate(223 104) skewY(-8)">
          <text
            class="fill-surface stroke-current font-display text-[122px] font-bold tracking-[-9px] stroke-[1.3px]"
            x="4"
            y="8">-RB-</text
          >
          <text
            class="fill-surface stroke-current font-display text-[122px] font-bold tracking-[-9px] stroke-[1.3px]"
            >-RB-</text
          >
        </g>
      </svg>
    </div>
    <div
      class="flex items-center gap-5 border-b border-line px-7 py-6.25 max-wide:gap-3.25 max-wide:px-4.25 [&>div]:min-w-0"
    >
      <Image
        class="h-35 w-35 shrink-0 rounded-sm border border-line object-cover max-wide:h-19.5 max-wide:w-17.5"
        src={portraitImage}
        alt="Rudhra Bharathy"
        width={160}
        height={160}
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <h1 class={titleClass}>{person.name}</h1>
        <div
          class="mt-1.75 flex flex-col items-start gap-1 text-muted max-wide:max-w-[25ch] max-wide:text-sm max-wide:leading-[1.55]"
        >
          <a
            href={person.locationLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            📍 Coimbatore, Tamil Nadu, India
          </a>
          <a href={`mailto:${person.email}`}>{person.email}</a>
          <p>+91 88705-62981</p>
        </div>
      </div>
    </div>
    <div
      class="grid grid-cols-2 border-b border-line [&>div]:px-7 [&>div]:py-3.5 [&>div+div]:border-l [&>div+div]:border-line max-wide:[&>div]:px-4 max-wide:[&>div]:py-3 max-wide:[&>div]:text-sm leading-[1.55]"
    >
      <div>
        <small class:list={[labelClass, "mb-1 block text-muted"]}
          >Currently</small
        >Technical Solutions Engineer at <a
          class={inlineLinkClass}
          href="https://www.userflow.com/">Userflow</a
        >
      </div>
      <div>
        <small class:list={[labelClass, "mb-1 block text-muted"]}>Socials</small
        >
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <a
            class={socialIconClass}
            href={person.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit LinkedIn profile"
            ><Icon
              name="simple-icons:linkedin"
              size={19}
              aria-hidden="true"
            /></a
          >
          <a
            class={socialIconClass}
            href={person.twitter}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit X profile"
            ><Icon name="simple-icons:x" size={19} aria-hidden="true" /></a
          >
          <a
            class={socialIconClass}
            href={person.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit GitHub profile"
            ><Icon name="simple-icons:github" size={19} aria-hidden="true" /></a
          >
          <a
            class={socialIconClass}
            href={person.devdotto}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit DEV profile"
            ><Icon name="fa6-brands:dev" size={19} aria-hidden="true" /></a
          >
        </div>
      </div>
    </div>

    <div
      class="space-y-3 px-7 py-6 max-wide:px-4.25 [&_p]:max-w-[64ch] [&_p]:text-pretty"
    >
      <p>
        I specialize in full-stack web development: building thoughtful
        interfaces and turning product ideas into working solutions.
      </p>
      <p>
        I also work directly with customers, investigate technical issues, and
        help teams turn real-world problems into product improvements.
      </p>
      <p>
        Outside work, I photograph the places I travel and the details I find
        along the way.
      </p>
    </div>
  </div>
  <div class="min-w-0">
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      id="projects"
      aria-labelledby="projects-heading"
    >
      <h2 class={sectionTitleClass} id="projects-heading">Things I’ve made.</h2>
      <Projects projects={projects} />
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="experience-heading"
    >
      <h2 class={sectionTitleClass} id="experience-heading">Experience</h2>
      <ExperienceList />
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="stack-heading"
    >
      <h2 class={sectionTitleClass} id="stack-heading">Stack</h2>
      <ol class="mt-4 border-t border-line">
        {
          stack.map((group, index) => (
            <li class="grid grid-cols-[150px_1fr] gap-5 border-b border-line py-4 max-wide:grid-cols-1 max-wide:gap-2.5">
              <div class="flex items-baseline gap-2.5">
                <span
                  class:list={[labelClass, "text-muted"]}
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="font-semibold">{group.label}</h3>
              </div>
              <ul class="flex list-none flex-wrap gap-2 p-0">
                {group.items.map((item) => (
                  <li class="rounded-md border border-line bg-wash px-2.5 py-1 text-sm">
                    {item}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      aria-labelledby="about-heading"
    >
      <h2 class={sectionTitleClass} id="about-heading">Beyond the screen.</h2>
      <div
        class="mt-4 flex items-center gap-4.5 max-wide:items-start [&_p]:max-w-110 [&_a]:text-sm [&_a]:leading-[1.55] leading-[1.55]"
      >
        <Image
          class="h-20.5 w-27.5 rounded-sm object-cover"
          src={kodaiImage}
          alt="Mountain landscape in Kodaikanal"
          width={220}
          loading="lazy"
        />
        <div>
          <p>I take photos when I travel. This one is from my Kodai Diaries.</p>
          <a class={inlineLinkClass} href="/gallery/"
            >Open the gallery <Icon
              name="lucide:arrow-right"
              size={15}
              aria-hidden="true"
            /></a
          >
        </div>
      </div>
    </section>
    <div class="section-divider h-2.25 border-y border-line" aria-hidden="true">
    </div>
    <section
      class="px-7 py-6.25 max-wide:px-4.25"
      id="contact"
      aria-labelledby="contact-heading"
    >
      <h2 class={sectionTitleClass} id="contact-heading">Let’s connect.</h2>
      <p class="mt-3 max-w-[60ch] text-muted">
        Have a project, a technical problem, or just want to say hello? Choose
        whichever channel works for you.
      </p>
      <form
        class="mt-5 grid gap-4"
        action={`mailto:${person.email}`}
        method="post"
        enctype="text/plain"
        data-contact-form
        data-recipient={person.email}
      >
        <label>
          <span class={labelClass}>Email or name</span>
          <input
            class={fieldClass}
            type="text"
            name="sender"
            autocomplete="name"
            placeholder="you@example.com or your name"
            required
          />
        </label>
        <label>
          <span class={labelClass}>Message</span>
          <textarea
            class={fieldClass}
            name="message"
            rows="5"
            placeholder="What would you like to discuss?"
            required></textarea>
        </label>
        <div>
          <button class={buttonClass} type="submit">
            <Icon name="lucide:send" size={15} aria-hidden="true" />Send message
          </button>
        </div>
      </form>
      <div class="mt-5 flex flex-wrap gap-3 border-t border-line pt-5">
        <a class={buttonClass} href={`mailto:${person.email}`}>
          <Icon name="lucide:mail" size={15} aria-hidden="true" />Email
        </a>
        <a
          class={buttonClass}
          href={person.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon
            name="simple-icons:whatsapp"
            size={15}
            aria-hidden="true"
          />WhatsApp
        </a>
        <a
          class={buttonClass}
          href={person.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon
            name="simple-icons:linkedin"
            size={15}
            aria-hidden="true"
          />LinkedIn
        </a>
      </div>
    </section>
  </div>
</main>

<script>
  const contactForm = document.querySelector<HTMLFormElement>(
    "[data-contact-form]",
  );

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const recipient = contactForm.dataset.recipient;
    if (!recipient) return;
    const data = new FormData(contactForm);
    const sender = String(data.get("sender") || "").trim();
    const message = String(data.get("message") || "").trim();
    const subject = encodeURIComponent(`Portfolio message from ${sender}`);
    const body = encodeURIComponent(message);
    window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
  });
</script>
