---
import { Icon } from "astro-icon/components";
import { buttonClass, labelClass, sectionTitleClass } from "../styles/classes";

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() || "";
const fieldClass =
  "mt-1.5 w-full rounded-md border border-line bg-page px-3 py-2.5 text-ink placeholder:text-muted focus:border-drawing focus:outline-none";
const WEB3FORMS_URL = "https://api.web3forms.com/submit";
---

<section
  class="px-7 py-6.25 max-wide:px-4.25"
  id="contact"
  aria-labelledby="contact-heading"
>
  <h2 class={sectionTitleClass} id="contact-heading">
    Let’s connect.
  </h2>
  <p class="mt-3 max-w-[60ch] text-muted">
    Have a project, a technical problem, or just want to say hello?
  </p>
  <form
    class="ph-no-capture mt-5 grid gap-4"
    action={WEB3FORMS_URL}
    method="post"
    data-contact-form
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="New portfolio message" />
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      tabindex="-1"
      aria-hidden="true"
    />
    <label>
      <span class={labelClass}>Email</span>
      <input
        class={fieldClass}
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
      />
    </label>
    <label>
      <span class={labelClass}>Message</span>
      <textarea
        class={fieldClass}
        name="message"
        rows="5"
        placeholder="What would you like to discuss?"
        required
      ></textarea>
    </label>
    <div>
      <button
        class={`${buttonClass} disabled:cursor-wait disabled:opacity-60`}
        type="submit"
        data-analytics-event="contact_submit_clicked"
      >
        <Icon name="lucide:send" size={15} aria-hidden="true" />
        Send message
      </button>
    </div>
    <p
      class="text-sm text-muted empty:hidden"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-contact-result
    ></p>
  </form>
</section>

<script>
  import { captureEvent, captureContactFailure } from "../libs/analytics";

  const contactForm = document.querySelector<HTMLFormElement>(
    "[data-contact-form]",
  );

  const result = contactForm?.querySelector<HTMLElement>(
    "[data-contact-result]",
  );
  const submitButton = contactForm?.querySelector<HTMLButtonElement>(
    "button[type='submit']",
  );

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!result || !submitButton || submitButton.disabled) return;

    const formData = new FormData(contactForm);
    if (!formData.get("access_key")) {
      captureContactFailure("missing_configuration");
      result.textContent =
        "The contact form is not configured yet. Please use the email link below.";
      return;
    }

    submitButton.disabled = true;
    contactForm.setAttribute("aria-busy", "true");
    result.textContent = "Sending...";

    try {
      const response = await fetch(contactForm.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: formData,
      });
      const data: { success?: boolean; message?: string } =
        await response.json();

      if (response.ok && data.success === true) {
        result.textContent =
          "Message sent successfully. Thanks for getting in touch!";
        contactForm.reset();
        captureEvent("contact_submit_succeeded");
      } else {
        captureContactFailure("provider_rejected", response.status);
        result.textContent =
          typeof data.message === "string" && data.message
            ? data.message
            : "Your message could not be sent. Please try again.";
      }
    } catch {
      captureContactFailure("request_failed");
      result.textContent =
        "Your message could not be sent. Please check your connection and try again.";
    } finally {
      submitButton.disabled = false;
      contactForm.removeAttribute("aria-busy");
    }
  });
</script>
