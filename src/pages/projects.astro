---
import { getCollection } from "astro:content";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Projects from "../components/Projects.astro";
import Site from "../layouts/Site.astro";
import { articleClass, labelClass, titleClass } from "../styles/classes";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Site title="Projects">
  <main id="main">
    <article class={articleClass}>
      <Breadcrumbs items={[{ label: "Projects" }]} />
      <span class:list={[labelClass, "mt-8 mb-0.75 block text-accent"]}>
        Selected work
      </span>
      <h1 class:list={[titleClass, "mt-2 mb-4.5"]}>Projects</h1>
      <p class="max-w-[64ch] text-muted">
        Browser extensions, web applications, and small experiments built to
        make an idea useful.
      </p>
      <div class="mt-6">
        <Projects projects={projects} heading="h2" />
      </div>
    </article>
  </main>
</Site>
