---
import { iconButtonClass, headingClass } from "../styles/classes";
import { Icon } from "astro-icon/components";
import portraitImage from "../assets/portrait.jpg";
import { person } from "../data";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Rudhra Bharathy — Technical Solutions Engineer at Userflow. Browser extensions, web apps, and the work behind them.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="dark" class="scroll-pt-5">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {person.name}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17191a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/assets/manrope.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/space.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ${person.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(portraitImage.src, Astro.site)}
    />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("rb-theme");
        if (saved === "dark" || saved === "light")
          document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body class="m-0 bg-page font-sans text-base leading-[1.55] text-ink print:[&_a]:no-underline">
    <a
      class="absolute left-[-9999px] focus:top-1 focus:left-2 focus:z-3 focus:bg-surface print:hidden"
      href="#main"
    >
      Skip to content
    </a>
    <div class="mx-auto min-h-screen max-w-201.5 border-x border-line bg-surface print:max-w-none print:border-0">
      <header class="flex min-h-15 items-center justify-between gap-3 border-b border-line px-6.25 py-3 max-wide:px-4 print:hidden">
        <a
          class:list={[
            headingClass,
            "text-2xl no-underline max-wide:text-[22px] font-light italic",
          ]}
          href="/"
        >
          -RB-<span class="sr-only">Rudhra Bharathy home</span>
        </a>
        <nav
          aria-label="Main navigation"
          class="flex items-center gap-2.5 max-wide:gap-1.5 [&>a]:px-1.25 [&>a]:py-2.5 [&>a]:text-sm [&>a]:leading-[1.55] [&>a]:no-underline [&>a[aria-current=page]]:text-accent"
        >
          <a
            class="transition-colors hover:text-accent"
            href="/experience/"
            aria-current={currentPath === "/experience/" ? "page" : undefined}
          >
            Experience
          </a>
          <a
            class="transition-colors hover:text-accent"
            href="/projects/"
            aria-current={currentPath === "/projects/" ? "page" : undefined}
          >
            Projects
          </a>
          <a
            class="transition-colors hover:text-accent"
            href="https://drive.google.com/file/d/1U09-TBzizTW41-rS8NhUv1Q714E8sl3t/view?usp=sharing"
            target="_blank"
            rel="noopener noreferrer"
          >
            Resume
          </a>
          <button
            class:list={[
              iconButtonClass,
              "min-w-8 min-h-8 theme-toggle-btn transition-colors hover:text-accent",
            ]}
            data-theme-toggle
            aria-label="Switch color theme"
          >
            <span class="theme-icon-wrap" aria-hidden="true">
              <Icon
                name="lucide:sun"
                size={15}
                class="theme-icon theme-icon-sun"
              />
              <Icon
                name="lucide:moon"
                size={15}
                class="theme-icon theme-icon-moon"
              />
            </span>
          </button>
        </nav>
      </header>
      <slot />
      <footer class="site-footer border-y border-line print:hidden">
        <div class="flex items-center justify-between gap-4 border-b border-line px-6.25 py-3.5 max-wide:px-4">
          <a
            class:list={[
              headingClass,
              "text-xl font-light italic no-underline",
            ]}
            href="/"
          >
            -RB-<span class="sr-only">Rudhra Bharathy home</span>
          </a>
          <nav class="flex items-center gap-1" aria-label="Social links">
            <a
              class:list={[iconButtonClass, "h-8 w-8"]}
              href={person.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit X profile"
            >
              <Icon name="simple-icons:x" size={15} aria-hidden="true" />
            </a>
            <a
              class:list={[iconButtonClass, "h-8 w-8"]}
              href={person.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit GitHub profile"
            >
              <Icon name="simple-icons:github" size={16} aria-hidden="true" />
            </a>
            <a
              class:list={[iconButtonClass, "h-8 w-8"]}
              href={person.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit LinkedIn profile"
            >
              <Icon name="simple-icons:linkedin" size={15} aria-hidden="true" />
            </a>
            <a
              class:list={[iconButtonClass, "h-8 w-8"]}
              href={person.devdotto}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit DEV profile"
            >
              <Icon name="fa6-brands:dev" size={16} aria-hidden="true" />
            </a>
          </nav>
        </div>
        <div
          class="footer-blueprint draft-grid overflow-hidden px-6.25 max-wide:px-4"
          aria-hidden="true"
        >
          <p class="footer-wordmark font-display">RUDHRA</p>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-6.25 py-4 text-sm max-wide:items-start max-wide:px-4">
          <p class="text-muted">
            Coimbatore, India <span aria-hidden="true">//</span> Available
            worldwide
          </p>
          <a
            class="inline-flex items-center gap-1.5"
            href={`mailto:${person.email}`}
          >
            Start a conversation
            <Icon name="lucide:arrow-up-right" size={15} aria-hidden="true" />
          </a>
        </div>
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );
      function updateTheme() {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        toggle?.setAttribute("aria-label", `Switch to ${next} theme`);
        const themeColor =
          root.dataset.theme === "dark" ? "#17191a" : "#f7f7f1";
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", themeColor);
      }
      updateTheme();
      toggle?.addEventListener("click", () => {
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
        try {
          localStorage.setItem("rb-theme", root.dataset.theme);
        } catch {}
        updateTheme();
      });
    </script>
  </body>
</html>
