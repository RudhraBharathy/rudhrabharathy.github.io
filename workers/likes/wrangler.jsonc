{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rudhra-portfolio-likes",
  "main": "index.ts",
  "compatibility_date": "2026-11-19",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://rudhrabharathy.github.io,http://localhost:4321,http://127.0.0.1:4321",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rudhra-portfolio-likes",
      "database_id": "99eb5f37-8db5-462f-af74-b5b7387f5f8d",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LIKE_RATE_LIMITER",
      "namespace_id": "193719",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
